{
  "cli": {
    "version": "24.8.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.15.1",
      "pnpm": "10.33.4",
      "env": {
        "WARDROBE_APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.15.1",
      "pnpm": "10.33.4",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "WARDROBE_APP_VARIANT": "preview"
      }
    },
    "production": {
      "node": "22.15.1",
      "pnpm": "10.33.4",
      "env": {
        "WARDROBE_APP_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
