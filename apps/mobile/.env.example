# Set reviewed local/test public URLs; phone localhost is not the computer.
EXPO_PUBLIC_GRAPHQL_URL=
# Optional public username only; never a Telegram bot token.
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=
# Provisional build identity. Confirm registrations before cloud/store use.
WARDROBE_APP_VARIANT=development
WARDROBE_ANDROID_PACKAGE=uz.wardrobestore.app.dev
WARDROBE_IOS_BUNDLE_IDENTIFIER=uz.wardrobestore.app.dev
WARDROBE_APP_SCHEME=wardrobe-development
WARDROBE_EAS_PROJECT_ID=
