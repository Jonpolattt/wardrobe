{
  "name": "@wardrobe/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "typecheck": "tsc --noEmit",
    "check:expo": "expo install --check",
    "postinstall": "node ../../scripts/mobile-workspace-prepare.cjs",
    "test": "node --test features/auth/tests/*.test.cjs features/links/tests/*.test.cjs features/catalog/tests/*.test.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/playfair-display": "0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.101.2",
    "@wardrobe/api-client": "workspace:*",
    "@wardrobe/config": "workspace:*",
    "@wardrobe/theme": "workspace:*",
    "@wardrobe/types": "workspace:*",
    "@wardrobe/utils": "workspace:*",
    "@wardrobe/validation": "workspace:*",
    "expo": "57.0.26",
    "expo-blur": "57.0.3",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.4",
    "expo-image": "57.0.5",
    "expo-linking": "57.0.11",
    "expo-localization": "57.0.2",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "i18next": "26.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.80.0",
    "react-i18next": "17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
