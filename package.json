{
  "name": "wardrobe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": "^22.13.0 || >=24.3.0" },
  "scripts": {
    "build": "turbo run build",
    "dev:web": "pnpm --filter fashion-marketplace-frontend dev",
    "dev:server": "pnpm --filter fashion-marketplace-backend start:dev",
    "dev:mobile": "pnpm --filter @wardrobe/mobile start",
    "local:plan": "node scripts/local-server.cjs",
    "test:integration": "node scripts/local-integration.cjs --run",
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "prisma:generate": "pnpm --filter fashion-marketplace-backend prisma:generate",
    "validate": "node scripts/validate.cjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.8.17"
  }
}
