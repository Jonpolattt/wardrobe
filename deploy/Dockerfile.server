# Build context must be the wardrobe repository root. Not yet production deployed.
FROM node:22.15.1-bookworm AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY . .
RUN pnpm --filter wardrobe --filter fashion-marketplace-backend... install --frozen-lockfile --ignore-scripts
ENV DATABASE_URL=file:./build-placeholder.db
RUN pnpm --filter fashion-marketplace-backend exec prisma generate --schema prisma/schema.prisma
RUN pnpm exec turbo run build --filter=fashion-marketplace-backend

FROM node:22.15.1-bookworm AS runtime
ENV NODE_ENV=production PORT=4000
COPY --from=build --chown=node:node /workspace /workspace
WORKDIR /workspace/apps/server
USER node
EXPOSE 4000
# Database migrations are an explicit separately approved operation.
CMD ["node", "dist/src/main.js"]
