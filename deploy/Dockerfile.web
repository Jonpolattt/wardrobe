# Build context must be the wardrobe repository root. Public values are build inputs.
FROM node:22.15.1-bookworm AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate
COPY . .
RUN pnpm --filter wardrobe --filter fashion-marketplace-frontend... install --frozen-lockfile --ignore-scripts
ARG NEXT_PUBLIC_GRAPHQL_URL=/graphql
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_TELEGRAM_BOT_USERNAME
ARG GRAPHQL_INTERNAL_URL=http://server:4000/graphql
# Next serializes rewrites at build time. The destination must match the approved deployment network.
ENV NEXT_PUBLIC_GRAPHQL_URL=$NEXT_PUBLIC_GRAPHQL_URL NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=$NEXT_PUBLIC_TELEGRAM_BOT_USERNAME NEXT_TELEMETRY_DISABLED=1 GRAPHQL_INTERNAL_URL=$GRAPHQL_INTERNAL_URL
RUN pnpm exec turbo run build --filter=fashion-marketplace-frontend

FROM node:22.15.1-bookworm AS runtime
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
COPY --from=build --chown=node:node /workspace /workspace
WORKDIR /workspace/apps/web
USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
