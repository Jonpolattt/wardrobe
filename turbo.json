{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "cache": false,
      "env": [
        "NEXT_PUBLIC_GRAPHQL_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_TELEGRAM_BOT_USERNAME",
        "GRAPHQL_INTERNAL_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start:dev": {
      "cache": false,
      "persistent": true
    }
  }
}
